# 企业部署推荐：使用开放平台生成的 Client ID / Client Secret。
WORKBUDDY_CLIENT_ID=
WORKBUDDY_CLIENT_SECRET=
WORKBUDDY_TOKEN_URL=https://copilot.tencent.com/oauth2/token
WORKBUDDY_OAUTH_SCOPE=

# 静态 API Key 可作为控制面认证备用；当前发布的专家也要求将它作为
# CODEBUDDY_API_KEY 注入私有 Runtime，因此 OAuth 模式下仍需设置。
WORKBUDDY_API_KEY=
WORKBUDDY_API_BASE=https://www.codebuddy.cn/v2/agentos
WORKBUDDY_SOURCE_APP=dreamworks-succession-main
WORKBUDDY_AGENT_ID=agent_01M1AB3GRFAR44G0ED9RQ51WY9
WORKBUDDY_AGENT_NAME=身家诊断专家

# 本地联调：true 使用确定性的模拟专家，不访问 WorkBuddy。
WORKBUDDY_MOCK=false

# 当前发布的“身家诊断专家”明确要求 Runtime secret CODEBUDDY_API_KEY。
WORKBUDDY_INJECT_API_KEY=true

# 默认保持平台权限模式；如真实专家工具需要自动执行，可在安全评审后改为 bypassPermissions。
WORKBUDDY_ACP_MODE=default
WORKBUDDY_RUNTIME_TIMEOUT_MS=50000
WORKBUDDY_RPC_TIMEOUT_MS=60000
WORKBUDDY_SESSION_TTL_MS=1800000
