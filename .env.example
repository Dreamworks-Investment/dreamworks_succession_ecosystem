# 梦工场官网 · 环境变量示例
# 复制为 .env 后填写真实值；切勿把填好的 .env 提交到版本库。

# ---------- 服务 ----------
PORT=8000
# 部署在反向代理/网关之后（火山引擎函数服务等）时保持 true，
# 限流会按 X-Forwarded-For 里的真实访客 IP 计数，避免全站共用一份额度。
TRUST_PROXY=true

# ---------- 会话签名密钥（必填，至少 32 字符）----------
STRATEGY_AUTH_SESSION_SECRET=
# 可选：会话有效期（秒），默认 28800（8 小时），范围 300~86400
STRATEGY_AUTH_SESSION_TTL_SECONDS=

# ---------- 各受保护区域的账号密码 ----------
STRATEGY_CASES_USERNAME=
STRATEGY_CASES_PASSWORD=
STRATEGY_AGENT_USERNAME=
STRATEGY_AGENT_PASSWORD=
VALUE_AGENT_USERNAME=
VALUE_AGENT_PASSWORD=
WEALTH_AGENT_USERNAME=
WEALTH_AGENT_PASSWORD=
TRUST_AGENT_USERNAME=
TRUST_AGENT_PASSWORD=
MARKET_AGENT_USERNAME=
MARKET_AGENT_PASSWORD=

# ---------- 市场专员 WorkBuddy 专家身份（可选，留空则沿用默认）----------
MARKET_WORKBUDDY_AGENT_ID=
MARKET_WORKBUDDY_AGENT_NAME=

# ---------- WorkBuddy Runtime 凭据 ----------
# 企业 OAuth（推荐）
WORKBUDDY_CLIENT_ID=
WORKBUDDY_CLIENT_SECRET=
WORKBUDDY_API_KEY=
WORKBUDDY_TOKEN_URL=
WORKBUDDY_OAUTH_SCOPE=
# Runtime 默认专家身份与网络环境
WORKBUDDY_AGENT_ID=
WORKBUDDY_AGENT_NAME=
WORKBUDDY_API_BASE=
WORKBUDDY_SOURCE_APP=
WORKBUDDY_INTERNET_ENVIRONMENT=
WORKBUDDY_ACP_MODE=
# 超时与会话参数（毫秒）
WORKBUDDY_RUNTIME_TIMEOUT_MS=
WORKBUDDY_RPC_TIMEOUT_MS=
WORKBUDDY_NO_TEXT_GRACE_MS=
WORKBUDDY_SESSION_TTL_MS=

# ---------- 市场专员文件通道（可选，留空用默认值）----------
# 底稿与封面图的本地暂存目录；默认系统临时目录，不进入发布包。
MARKET_AGENT_WORKSPACE_ROOT=
# 单次上传总量 / 单文件大小上限（字节）
MARKET_AGENT_MAX_UPLOAD_BYTES=
MARKET_AGENT_MAX_FILE_BYTES=
# 注入 prompt 的文本 / base64 单文件上限（字节）
WORKBUDDY_FILE_TEXT_BYTES=
WORKBUDDY_FILE_BASE64_BYTES=
# prompt 总长度上限；市场专员默认 4MB，身家诊断默认 20KB
WORKBUDDY_MAX_PROMPT_BYTES=

# ---------- 飞书 Aily 会话面板配置 ----------
# 各专员的频道 Token（受保护，仅服务端使用）
VALUE_AILY_CHANNEL_TOKEN=
WEALTH_AILY_CHANNEL_TOKEN=
TRUST_AILY_CHANNEL_TOKEN=
STRATEGY_AILY_SDK_VERSION=
STRATEGY_AILY_IFRAME_ORIGIN=
STRATEGY_AILY_ALLOWED_HOST=

# ---------- 本地演示 ----------
# 设为 true 时 AI 会话走模拟数据，服务显示“已配置”，便于本地演示；
# 生产环境必须设为 false 或删除，并配置真实 WorkBuddy 凭据。
WORKBUDDY_MOCK=
